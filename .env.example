# ── Shioaji credentials ──────────────────────────────────────────────
# Required by `shioaji server start` (the CLI reads .env from this dir).
# Create your API key / secret key at:
#   https://www.sinotrade.com.tw/newweb/PythonAPIKey/
# Copy this file to `.env` and fill in your keys. NEVER commit `.env`.
SJ_API_KEY=your_api_key_here
SJ_SEC_KEY=your_secret_key_here

# The server runs in SIMULATION mode by default (paper trading).
# Only set this to true when you are ready for real trading — it also
# requires your CA certificate (SJ_CA_PATH / SJ_CA_PASSWD).
# SJ_PRODUCTION=true

# ── Frontend (optional) ──────────────────────────────────────────────
# Public Web traffic uses the loopback Autotrade Gateway, not the Shioaji
# sidecar directly.  The Gateway is SIM/DISARMED and remains the mutation
# boundary; it reads from a separately configured sidecar internally.
# VITE_API_TARGET=http://127.0.0.1:18082

# Only an explicitly provisioned Gateway origin may override the Web API base.
# Never point it at a Shioaji sidecar or a remote broker service.
# VITE_API_BASE=http://127.0.0.1:18082

# Build-time public base path when deploying as a shioaji custom app.
# VITE_BASE=/apps/shioaji-pro-app/

# Optional: Google Analytics 4. Used only for app_open + app_heartbeat,
# so GA Realtime can show active users in the last 5/30 minutes.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
